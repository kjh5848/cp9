<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nomadlab.cp9-codex-publisher</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "/Users/nomadlab/codex-work/cp9" &amp;&amp; /usr/bin/env node tools/codex-publisher/nightly-autopublish-worker.mjs --bypass-sandbox</string>
  </array>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>/Users/nomadlab/codex-work/cp9</string>

  <key>StandardOutPath</key>
  <string>/Users/nomadlab/codex-work/cp9/logs/codex-publisher/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/nomadlab/codex-work/cp9/logs/codex-publisher/launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CODEX_AUTOPUBLISH_CWD</key>
    <string>/Users/nomadlab/codex-work/cp9</string>
    <key>CODEX_AUTOPUBLISH_BYPASS_SANDBOX</key>
    <string>true</string>
  </dict>
</dict>
</plist>
